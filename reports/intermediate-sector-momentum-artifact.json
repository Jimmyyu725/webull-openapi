      "query": {
        "engine": "sqlite-json1",
        "language": "sql",
        "sql": "WITH report(payload) AS (SELECT json(:report_json)), portfolios(portfolio, json_path) AS (VALUES ('中期动量 零成本', '$.development.strategy.zero'), ('中期动量 基准成本', '$.development.strategy.base'), ('中期动量 压力成本', '$.development.strategy.stress'), ('30% SPY', '$.development.benchmarks.spy'), ('30% 行业等权', '$.development.benchmarks.equal_weight')), portfolio_rows AS (SELECT 'portfolio_comparison' AS dataset, portfolio AS item, CAST(json_extract(payload, json_path || '.account_return') AS REAL) AS primary_value, CAST(json_extract(payload, json_path || '.net_profit') AS REAL) AS net_profit, CAST(json_extract(payload, json_path || '.cagr') AS REAL) AS cagr, CAST(json_extract(payload, json_path || '.annualized_sharpe') AS REAL) AS sharpe, CAST(json_extract(payload, json_path || '.max_drawdown') AS REAL) AS max_drawdown, CAST(json_extract(payload, json_path || '.transaction_cost') AS REAL) AS transaction_cost, NULL AS status FROM report CROSS JOIN portfolios), summary_row AS (SELECT 'summary' AS dataset, 'base_vs_equal' AS item, CAST(json_extract(payload, '$.development.strategy.base.account_return') AS REAL) AS primary_value, CAST(json_extract(payload, '$.development.benchmarks.equal_weight.account_return') AS REAL) AS net_profit, CAST(json_extract(payload, '$.development.strategy.base.excess_equal_weight.annualized_information_ratio') AS REAL) AS cagr, CAST(json_extract(payload, '$.development.strategy.base.excess_equal_weight.t_stat') AS REAL) AS sharpe, CAST(json_extract(payload, '$.development.gate.cost_erosion') AS REAL) AS max_drawdown, NULL AS transaction_cost, json_extract(payload, '$.decision') AS status FROM report), gate_rows AS (SELECT 'gate_checks' AS dataset, gate.key AS item, CAST(gate.value AS REAL) AS primary_value, NULL AS net_profit, NULL AS cagr, NULL AS sharpe, NULL AS max_drawdown, NULL AS transaction_cost, CASE CAST(gate.value AS INTEGER) WHEN 1 THEN '通过' ELSE '失败' END AS status FROM report, json_each(json_extract(payload, '$.development.gate.checks')) AS gate) SELECT * FROM portfolio_rows UNION ALL SELECT * FROM summary_row UNION ALL SELECT * FROM gate_rows",
        "description": "以阶段Gate JSON作为绑定参数，提取组合比较、摘要与Gate明细，再整形成报告中的三个已复核数据集。",
